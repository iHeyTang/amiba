{
  "name": "@hermes-x/extension-cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI for developing hermes-x desktop extensions.",
  "type": "module",
  "bin": {
    "hermes-x-ext": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "exports": {
    ".": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "prepare": "tsc"
  },
  "files": ["dist", "src/template"],
  "dependencies": {
    "commander": "^12.0.0",
    "kleur": "^4.1.5",
    "prompts": "^2.4.2",
    "tar": "^7.0.0"
  },
  "devDependencies": {
    "@hermes-x/extension-api": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.9",
    "@types/tar": "^6.1.0",
    "typescript": "5.6.3"
  }
}
