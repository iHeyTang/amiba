{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    // Set so TypeScript can follow ``@hermes-x/core``'s barrel through
    // ``sessions-runtime/provider.tsx`` when main-process code imports
    // from the package. No main-process file actually contains JSX —
    // the flag only affects checking of files we transitively touch.
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "electron"]
  },
  "include": ["src/main", "src/preload", "electron.vite.config.ts"]
}
