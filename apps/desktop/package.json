{
  "name": "@hermes-x/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Hermes desktop app (Electron + Vite + React).",
  "author": "iHeyTang",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "concurrently --names \"runner,desktop\" --prefix-colors \"yellow,cyan\" --kill-others-on-fail \"vite build --config vite.runner.config.ts --watch\" \"electron-vite dev\"",
    "build": "vite build --config vite.runner.config.ts && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "package": "vite build --config vite.runner.config.ts && electron-vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "build": {
    "appId": "com.iheytang.hermes",
    "productName": "Hermes",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Hermes uses the microphone for voice input to the chat composer.",
        "NSCameraUsageDescription": "Hermes does not use the camera; this entry exists only to satisfy Electron's permission probe."
      }
    },
    "win": {
      "icon": "resources/icon.png",
      "target": "nsis"
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@hermes-x/core": "workspace:*",
    "@hermes-x/ext-knowledge-base": "workspace:*",
    "@hermes-x/extension-api": "workspace:*",
    "@hermes-x/extension-host": "workspace:*",
    "@hermes-x/i18n": "workspace:*",
    "@hermes-x/platform": "workspace:*",
    "@hermes-x/ui": "workspace:*",
    "@hermes-x/utils": "workspace:*",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^3.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "node-pty": "^1.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.27.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^2.5.4",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@hermes-x/tailwind-preset": "workspace:*",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "^5.4.11"
  }
}
