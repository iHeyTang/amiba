{
  "name": "@amiba/desktop",
  "version": "0.1.4",
  "private": true,
  "description": "DSH-native desktop agent app (Electron + Vite + React).",
  "author": "iHeyTang",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev-desktop.mjs",
    "runtime:prepare": "pnpm --dir ../../packages/app-runtime runtime:prepare",
    "runtime:verify": "pnpm --dir ../../packages/app-runtime runtime:verify",
    "prebuild": "pnpm --dir ../../packages/app-runtime build:dsh-runtime",
    "build": "pnpm runtime:prepare && electron-vite build && node scripts/verify-desktop-bundle.mjs",
    "preview": "electron-vite preview",
    "start": "electron .",
    "prepackage": "pnpm --dir ../../packages/app-runtime build:dsh-runtime",
    "package": "pnpm runtime:prepare && electron-vite build && node scripts/fix-node-pty-permissions.mjs && electron-builder",
    "postinstall": "electron-builder install-app-deps && node scripts/fix-node-pty-permissions.mjs",
    "pretest": "pnpm --dir ../../packages/app-runtime build:dsh-runtime",
    "test": "node --experimental-strip-types --test src/main/__tests__/*.test.mjs",
    "pretypecheck": "pnpm --dir ../../packages/app-runtime build:dsh-runtime",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test:surfaces": "node scripts/smoke-surfaces.mjs",
    "test:pets": "pnpm --dir ../../plugins/dsh-plugin-pets build && node scripts/smoke-pets.mjs"
  },
  "build": {
    "appId": "com.iheytang.amiba",
    "productName": "Amiba",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "../../packages/app-runtime/resources/dsh-runtime",
        "to": "resources/dsh-runtime"
      }
    ],
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg"
        }
      ],
      "extendInfo": {}
    },
    "win": {
      "icon": "resources/icon.png",
      "target": "nsis"
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@amiba/app-runtime": "workspace:*",
    "@amiba/extension-sdk": "workspace:*",
    "@amiba/i18n": "workspace:*",
    "@amiba/ui": "workspace:*",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "chokidar": "^3.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.6.2",
    "lexical": "^0.21.0",
    "lucide-react": "^0.460.0",
    "node-pty": "^1.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.27.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^2.5.4",
    "uiohook-napi": "^1.5.4",
    "ws": "8.21.0",
    "@amiba/dsh-plugin-session-features": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "^5.4.11"
  }
}
