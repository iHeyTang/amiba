{
  "name": "@amiba/app-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Amiba application runtime: domain, platform, DSH, and utility services.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./platform": "./src/platform/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./dsh-client": "./src/dsh-client/index.ts",
    "./dsh-distribution": {
      "types": "./src/dsh-distribution/index.d.ts",
      "default": "./src/dsh-distribution/index.js"
    },
    "./dsh-runtime": {
      "types": "./dist/dsh-runtime/index.d.ts",
      "default": "./dist/dsh-runtime/index.js"
    },
    "./dsh-runtime-manifest": "./dsh-runtime-manifest.json",
    "./utils": "./src/utils/index.ts"
  },
  "scripts": {
    "build:dsh-runtime": "tsc -p tsconfig.dsh-runtime.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "runtime:prepare": "pnpm build:dsh-runtime && node scripts/dsh-runtime/prepare.mjs",
    "runtime:rebuild": "pnpm build:dsh-runtime && node scripts/dsh-runtime/prepare.mjs --force",
    "runtime:verify": "pnpm build:dsh-runtime && node scripts/dsh-runtime/prepare.mjs --verify",
    "runtime:smoke": "pnpm build:dsh-runtime && node scripts/dsh-runtime/smoke.mjs",
    "runtime:lock": "node scripts/dsh-runtime/prepare.mjs --update-lock"
  },
  "dependencies": {},
  "peerDependencies": {
    "electron": "*",
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "react": "18.3.1",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
