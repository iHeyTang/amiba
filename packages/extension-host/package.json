{
  "name": "@hermes-x/extension-host",
  "version": "0.1.0",
  "private": true,
  "description": "Loader, registry, and host APIs for hermes-x desktop extensions.",
  "main": "src/main/index.ts",
  "types": "src/main/index.ts",
  "exports": {
    "./main": "./src/main/index.ts",
    "./preload": "./src/preload/index.ts",
    "./renderer": "./src/renderer/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hermes-x/extension-api": "workspace:*",
    "@hermes-x/i18n": "workspace:*"
  },
  "peerDependencies": {
    "electron": "*",
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "electron": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "react": "18.3.1",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
