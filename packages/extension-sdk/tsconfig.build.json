{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src"],
  // The guard is typecheck-only: it imports the official ui-layout client
  // types, whose cordis Context merge must never reach published output.
  "exclude": ["src/slot-vocabulary-guard.ts"]
}
