{
  "name": "@amiba/extension-sdk",
  "version": "0.1.0",
  "description": "Public authoring contracts for DSH plugins targeting the Amiba shell.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.guard.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-runtime": "catalog:",
    "@deepseek-ai/dsh-client-ui-commands": "catalog:",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:",
    "@deepseek-ai/dsh-client-ui-input-trigger": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-client-ui-tool": "catalog:",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-runtime": "catalog:",
    "@deepseek-ai/dsh-client-ui-commands": "catalog:",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:",
    "@deepseek-ai/dsh-client-ui-input-trigger": "catalog:",
    "@deepseek-ai/dsh-client-ui-layout": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-client-ui-tool": "catalog:",
    "typescript": "5.6.3",
    "@types/react": "18.3.12",
    "react": "18.3.1"
  },
  "dependencies": {
    "@amiba/markdown": "workspace:*"
  }
}
