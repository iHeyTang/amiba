{
  "name": "amiba",
  "version": "0.1.0",
  "private": true,
  "description": "Hermes multi-target workspace (browser extension + Electron desktop, shared React UI).",
  "author": "iHeyTang",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:browser-extension": "pnpm --dir apps/browser-extension dev",
    "dev:desktop": "node apps/desktop/scripts/dev-desktop.mjs",
    "dev:desktop:fresh": "bash scripts/fresh-desktop.sh",
    "dev:desktop:fresh:keep": "bash scripts/fresh-desktop.sh --keep",
    "dev:desktop:fresh:reset": "bash scripts/fresh-desktop-reset.sh",
    "runtime:prepare": "node apps/desktop/scripts/prepare-hermes-runtime.mjs",
    "runtime:prepare:local": "node apps/desktop/scripts/prepare-hermes-runtime.mjs --dev",
    "runtime:rebuild": "node apps/desktop/scripts/prepare-hermes-runtime.mjs --force",
    "runtime:info": "node apps/desktop/scripts/dev-desktop.mjs --runtime-info",
    "runtime:verify": "node apps/desktop/scripts/prepare-hermes-runtime.mjs --verify",
    "build:browser-extension": "pnpm --dir apps/browser-extension build",
    "build:desktop": "pnpm --dir apps/desktop build",
    "package:desktop": "pnpm --dir apps/desktop package",
    "clean": "pnpm -r exec rm -rf node_modules dist build .plasmo .turbo .vite",
    "lint:no-extension-leak": "bash scripts/check-no-knowledge-in-core.sh",
    "sdk:pack": "bash scripts/sdk-pack.sh",
    "sdk:verify-scaffold": "bash scripts/verify-scaffold.sh"
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "typescript": "5.6.3"
  }
}
