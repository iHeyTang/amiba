{
  "name": "amiba",
  "version": "0.1.0",
  "private": true,
  "description": "DSH-native desktop agent workspace with plugin-owned host capabilities.",
  "author": "iHeyTang",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "dev:desktop": "node apps/desktop/scripts/dev-desktop.mjs",
    "dev:desktop:fresh": "bash scripts/fresh-desktop.sh",
    "dev:desktop:fresh:keep": "bash scripts/fresh-desktop.sh --keep",
    "dev:desktop:fresh:reset": "bash scripts/fresh-desktop-reset.sh",
    "runtime:prepare": "pnpm --dir packages/app-runtime runtime:prepare",
    "runtime:rebuild": "pnpm --dir packages/app-runtime runtime:rebuild",
    "runtime:info": "node apps/desktop/scripts/dev-desktop.mjs --runtime-info",
    "runtime:verify": "pnpm --dir packages/app-runtime runtime:verify",
    "runtime:smoke": "pnpm --dir packages/app-runtime runtime:smoke",
    "verify:architecture": "node --test scripts/tool-dispatch-contract.test.mjs && node scripts/verify-dsh-architecture.mjs",
    "verify:pluginization": "node scripts/verify-pluginization.mjs",
    "build:desktop": "pnpm --dir apps/desktop build",
    "package:desktop": "pnpm --dir apps/desktop package",
    "clean": "pnpm -r exec rm -rf node_modules dist build .turbo .vite",
    "lint:no-extension-leak": "bash scripts/check-no-knowledge-in-core.sh",
    "sdk:pack": "bash scripts/sdk-pack.sh",
    "sdk:verify-scaffold": "bash scripts/verify-scaffold.sh",
    "runtime:lock": "pnpm --dir packages/app-runtime runtime:lock",
    "verify:browser": "node scripts/verify-browser-pluginization.mjs"
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "@deepseek-ai/dsh-client-ui-renderer@0.1.1-rc.2": "patches/@deepseek-ai__dsh-client-ui-renderer@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-session@0.1.1-rc.2": "patches/@deepseek-ai__dsh-session@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-tools@0.1.1-rc.2": "patches/@deepseek-ai__dsh-tools@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-client-connection@0.1.1-rc.2": "patches/@deepseek-ai__dsh-client-connection@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-session-log-export@0.1.1-rc.2": "patches/@deepseek-ai__dsh-session-log-export@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-client-runtime@0.1.1-rc.2": "patches/@deepseek-ai__dsh-client-runtime@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-client-ui-settings-plugins@0.1.1-rc.2": "patches/@deepseek-ai__dsh-client-ui-settings-plugins@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-client-ui-directory-picker-native@0.1.1-rc.2": "patches/@deepseek-ai__dsh-client-ui-directory-picker-native@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-client-ui-conversation@0.1.1-rc.2": "patches/@deepseek-ai__dsh-client-ui-conversation@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-client-ui-trajectory@0.1.1-rc.2": "patches/@deepseek-ai__dsh-client-ui-trajectory@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-client-ui-slots@0.1.1-rc.2": "patches/@deepseek-ai__dsh-client-ui-slots@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-client-ui-primitives@0.1.1-rc.2": "patches/@deepseek-ai__dsh-client-ui-primitives@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-commands@0.1.1-rc.2": "patches/@deepseek-ai__dsh-commands@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-api-remotes@0.1.1-rc.2": "patches/@deepseek-ai__dsh-api-remotes@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-client-ui-commands@0.1.1-rc.2": "patches/@deepseek-ai__dsh-client-ui-commands@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-llm@0.1.1-rc.2": "patches/@deepseek-ai__dsh-llm@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-attachment@0.1.1-rc.2": "patches/@deepseek-ai__dsh-attachment@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-fs@0.1.1-rc.2": "patches/@deepseek-ai__dsh-fs@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-fs-local@0.1.1-rc.2": "patches/@deepseek-ai__dsh-fs-local@0.1.1-rc.2.patch"
    }
  }
}
