{
  "name": "amiba",
  "version": "0.1.3",
  "private": true,
  "description": "DSH-native desktop agent workspace with plugin-owned host capabilities.",
  "author": "iHeyTang",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "dev:desktop": "node apps/desktop/scripts/dev-desktop.mjs",
    "dev:desktop:fresh": "bash scripts/fresh-desktop.sh",
    "dev:desktop:fresh:keep": "bash scripts/fresh-desktop.sh --keep",
    "dev:desktop:fresh:reset": "bash scripts/fresh-desktop-reset.sh",
    "runtime:prepare": "pnpm --dir packages/app-runtime runtime:prepare",
    "runtime:rebuild": "pnpm --dir packages/app-runtime runtime:rebuild",
    "runtime:info": "node apps/desktop/scripts/dev-desktop.mjs --runtime-info",
    "runtime:verify": "pnpm --dir packages/app-runtime runtime:verify",
    "runtime:smoke": "pnpm --dir packages/app-runtime runtime:smoke",
    "verify:architecture": "node scripts/verify-dsh-architecture.mjs",
    "verify:pluginization": "node scripts/verify-pluginization.mjs",
    "build:desktop": "pnpm --dir apps/desktop build",
    "package:desktop": "pnpm --dir apps/desktop package",
    "clean": "pnpm -r exec rm -rf node_modules dist build .turbo .vite",
    "lint:no-extension-leak": "bash scripts/check-no-knowledge-in-core.sh",
    "sdk:pack": "bash scripts/sdk-pack.sh",
    "sdk:verify-scaffold": "bash scripts/verify-scaffold.sh",
    "runtime:lock": "pnpm --dir packages/app-runtime runtime:lock",
    "verify:browser": "node scripts/verify-browser-pluginization.mjs",
    "release:build": "node scripts/release/build.mjs",
    "release:upload": "node scripts/release/upload.mjs",
    "release:cdn": "node scripts/release/sync-cdn.mjs",
    "release:verify-online": "node scripts/release/verify-online.mjs",
    "release:version": "node scripts/release/version.mjs",
    "release:version:check": "node scripts/release/version.mjs --check"
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "yaml": "2.8.1",
    "semver": "7.7.4"
  },
  "pnpm": {
    "patchedDependencies": {
      "@deepseek-ai/dsh-session@0.1.1-rc.2": "patches/@deepseek-ai__dsh-session@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-tools@0.1.1-rc.2": "patches/@deepseek-ai__dsh-tools@0.1.1-rc.2.patch",
      "@deepseek-ai/dsh-client-connection@0.1.1-rc.2": "patches/@deepseek-ai__dsh-client-connection@0.1.1-rc.2.patch"
    },
    "overrides": {}
  },
  "amiba": {
    "runtimePatches": {
      "@deepseek-ai/cordis-plugin-hmr@1.0.16": "patches/@deepseek-ai__cordis-plugin-hmr@1.0.16.patch"
    }
  }
}
