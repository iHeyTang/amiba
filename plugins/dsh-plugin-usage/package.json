{
  "name": "@amiba/dsh-plugin-usage",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin projecting provider-reported token usage from canonical session logs.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./projector": { "types": "./lib/projector.d.ts", "default": "./lib/projector.js" }
  },
  "files": ["lib", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@amiba/app-runtime": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-query": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-query": "0.1.0-rc.6",
    "@types/node": "22.9.0",
    "typescript": "5.6.3",
    "vitest": "^2.1.4"
  }
}
