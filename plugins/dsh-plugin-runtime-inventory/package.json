{
  "name": "@amiba/dsh-plugin-runtime-inventory",
  "version": "0.1.0",
  "private": true,
  "description": "Amiba plugin management UI over the official DSH Loader inventory and profile plugin command.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "external": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-settings",
        "react",
        "react-dom",
        "react/jsx-runtime",
        "@amiba/dsh-plugin-ui-shell",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@amiba/dsh-plugin-ui-shell",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@amiba/dsh-plugin-ui-shell": "workspace:*",
    "@amiba/extension-sdk": "workspace:*",
    "@amiba/ui": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@deepseek-ai/dsh-host-plugin-inventory": "catalog:",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.1",
    "@deepseek-ai/dsh-api-settings-controller": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@deepseek-ai/dsh-host-plugin-inventory": "catalog:",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "^5.4.11",
    "lucide-react": "^0.460.0",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.1",
    "@deepseek-ai/dsh-api-settings-controller": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.1"
  },
  "author": "Amiba",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iHeyTang/amiba.git",
    "directory": "plugins/dsh-plugin-runtime-inventory"
  }
}
