{
  "name": "@amiba/dsh-plugin-memory-memos",
  "version": "0.1.0",
  "private": true,
  "description": "Amiba built-in MemOS memory integration.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "external": [
        "@amiba/dsh-plugin-ui-shell/client",
        "react",
        "react-dom",
        "react/jsx-runtime"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@amiba/dsh-plugin-ui-shell"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@amiba/dsh-plugin-catalog": "workspace:*",
    "@amiba/dsh-plugin-ui-shell": "workspace:*",
    "@amiba/ui": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "zod": "^4.4.3",
    "@memtensor/memos-local-plugin": "2.0.18",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-system-prompt": "catalog:",
    "@deepseek-ai/dsh-timeout": "catalog:",
    "@amiba/markdown": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@deepseek-ai/dsh-util-values": "0.1.5-rc.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "jsdom": "^25.0.1",
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.4",
    "lucide-react": "^0.460.0",
    "@deepseek-ai/dsh-util-values": "0.1.5-rc.2"
  },
  "amiba": {
    "distribution": {
      "overrides": {
        "@memtensor/memos-local-plugin@2.0.18": {
          "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
          "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
          "@deepseek-ai/dsh-session": "0.1.5-rc.2",
          "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.2",
          "@deepseek-ai/dsh-timeout": "0.1.5-rc.2",
          "@deepseek-ai/dsh-tools": "0.1.5-rc.2"
        }
      },
      "targets": {
        "darwin-x64": {
          "overrides": {
            "onnxruntime-node": "1.22.0"
          }
        }
      }
    }
  }
}
