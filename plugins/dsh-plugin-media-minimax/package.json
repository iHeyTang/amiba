{
  "name": "@amiba/dsh-plugin-media-minimax",
  "version": "0.1.0",
  "description": "MiniMax China media extension for the official DSH provider",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "MEDIA-COVERAGE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-credentials": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-settings": "catalog:",
    "@amiba/dsh-plugin-media": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-credentials": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-settings": "catalog:",
    "typescript": "5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.4",
    "@types/node": "22.9.0",
    "@amiba/dsh-plugin-media": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@amiba/dsh-plugin-media": {
      "optional": true
    }
  }
}
