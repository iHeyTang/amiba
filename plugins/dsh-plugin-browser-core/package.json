{
  "name": "@amiba/dsh-plugin-browser-core",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral browser tools and lifecycle for Amiba DSH.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@amiba/dsh-plugin-catalog": "workspace:*",
    "@deepseek-ai/dsh-attachment": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@amiba/ui": "workspace:*",
    "@amiba/extension-sdk": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@amiba/dsh-plugin-ui-shell": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.5-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@types/node": "22.9.0",
    "typescript": "5.6.3",
    "vitest": "^2.1.4",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "vite": "^5.4.11",
    "lucide-react": "^0.460.0",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.5-rc.1"
  },
  "dsh": {
    "client": {
      "external": [
        "react",
        "react-dom",
        "react/jsx-runtime",
        "@amiba/dsh-plugin-ui-shell/client"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "author": "Amiba",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iHeyTang/amiba.git",
    "directory": "plugins/dsh-plugin-browser-core"
  }
}
