{
  "name": "@amiba/dsh-plugin-runtime-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin exposing the authenticated Amiba desktop runtime gateway as a Cordis service.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@amiba/dsh-plugin-catalog": "workspace:*",
    "@deepseek-ai/schemastery": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.5-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@types/node": "22.9.0",
    "typescript": "5.6.3",
    "vitest": "^2.1.4",
    "@deepseek-ai/dsh-util-values": "0.1.5-rc.1"
  },
  "author": "Amiba",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iHeyTang/amiba.git",
    "directory": "plugins/dsh-plugin-runtime-gateway"
  }
