{
  "name": "@amiba/dsh-plugin-browser-provider-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Installable workbench browser with plugin-owned UI, Electron execution, and lifecycle.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build && vite build --config vite.native.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@types/node": "22.9.0",
    "typescript": "5.6.3",
    "vitest": "^2.1.4",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "jsdom": "^25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "^5.4.11",
    "electron": "^33.2.0",
    "@amiba/dsh-plugin-browser-core": "workspace:*",
    "@amiba/dsh-plugin-runtime-gateway": "workspace:*",
    "@amiba/ui": "workspace:*",
    "@amiba/extension-sdk": "workspace:*",
    "@amiba/dsh-plugin-ui-shell": "workspace:*",
    "@amiba/app-runtime": "workspace:*",
    "@amiba/i18n": "workspace:*",
    "lucide-react": "^0.460.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-settings",
        "@amiba/dsh-plugin-ui-shell",
        "@amiba/dsh-plugin-workbench"
      ],
      "platform": "web",
      "external": [
        "@amiba/dsh-plugin-ui-shell/client",
        "react",
        "react/jsx-runtime"
      ]
    },
    "native": "./lib/native.cjs",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@amiba/dsh-plugin-workbench": "workspace:*"
  }
}
