{
  "name": "@amiba/dsh-plugin-pets",
  "version": "0.1.0",
  "private": true,
  "description": "Mofli pet library, companion surfaces, and agent creation tools for Amiba.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "node scripts/prepare-mofli.mjs && tsc -p tsconfig.build.json && vite build",
    "typecheck": "node scripts/prepare-mofli.mjs && tsc --noEmit",
    "test": "node scripts/prepare-mofli.mjs && vitest run",
    "prepare:mofli": "node scripts/prepare-mofli.mjs"
  },
  "dsh": {
    "client": {
      "external": [
        "@amiba/dsh-plugin-ui-shell/client",
        "react",
        "react/jsx-runtime"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@amiba/dsh-plugin-ui-shell",
        "@amiba/dsh-plugin-notification-hub"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@amiba/dsh-plugin-ui-shell": "workspace:*",
    "@amiba/ui": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "lucide-react": "^0.460.0",
    "zod": "^4.4.3",
    "@mofli/core": "0.1.1",
    "@mofli/grove": "0.1.1",
    "@mofli/studio": "0.1.1",
    "@amiba/dsh-plugin-notification-hub": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-client-runtime": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@amiba/extension-sdk": "^0.1.0",
    "@amiba/dsh-plugin-onboarding": "workspace:*"
  },
  "devDependencies": {
    "@amiba/app-runtime": "workspace:*",
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-client-runtime": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "jsdom": "^25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.4",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@amiba/extension-sdk": "workspace:*",
    "@amiba/dsh-plugin-onboarding": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@amiba/dsh-plugin-onboarding": {
      "optional": true
    }
  }
}
