{
  "name": "@amiba/dsh-plugin-provider-tokendance",
  "version": "0.1.0",
  "description": "TokenDance provider for the official DeepSeek Harness LLM, settings and credentials interfaces.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "MEDIA-COVERAGE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm-pi-ai": "catalog:",
    "@earendil-works/pi-ai": "0.85.1",
    "@deepseek-ai/schemastery": "catalog:",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@amiba/dsh-plugin-media": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "typescript": "5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.4",
    "@types/node": "22.9.0",
    "@amiba/dsh-plugin-media": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@amiba/dsh-plugin-media": {
      "optional": true
    }
  }
}
