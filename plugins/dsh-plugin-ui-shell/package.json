{
  "name": "@amiba/dsh-plugin-ui-shell",
  "version": "0.1.0",
  "description": "DSH client root and semantic child-slot ownership for the Amiba workbench.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "LICENSE.deepseek"
  ],
  "dsh": {
    "client": {
      "external": [
        "@deepseek-ai/dsh-client-ui-slots",
        "react",
        "react-dom",
        "react/jsx-runtime",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@amiba/extension-sdk": "^0.1.0",
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-runtime": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@deepseek-ai/dsh-typert-protocol": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2"
  },
  "dependencies": {
    "@amiba/app-runtime": "workspace:*",
    "@amiba/i18n": "workspace:*",
    "@amiba/ui": "workspace:*",
    "lucide-react": "^0.460.0",
    "@amiba/markdown": "workspace:*",
    "zod": "^4.1.5",
    "streamdown": "^2.5.0",
    "@deepseek-ai/dsh-skill": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session-log-export": "catalog:",
    "@amiba/extension-sdk": "workspace:*",
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-locale": "catalog:",
    "@deepseek-ai/dsh-client-runtime": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@testing-library/react": "^16.0.1",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.460.0",
    "postcss": "8.4.49",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.4",
    "@deepseek-ai/dsh-typert-protocol": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-client-ui-directory-picker-native": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@types/picomatch": "4.0.2",
    "picomatch": "4.0.4"
  }
}
