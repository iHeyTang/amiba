{
  "name": "@amiba/dsh-plugin-attachments",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin for reading Amiba-managed text and PDF attachments.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "LICENSE.deepseek"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@amiba/dsh-plugin-catalog": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "pdfjs-dist": "6.1.200",
    "zod": "^4.4.3",
    "@amiba/ui": "workspace:*",
    "@amiba/extension-sdk": "workspace:*",
    "lucide-react": "^0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@deepseek-ai/dsh-client-runtime": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@types/node": "22.9.0",
    "typescript": "5.6.3",
    "vitest": "^2.1.4",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "vite": "^5.4.11",
    "@deepseek-ai/dsh-fs-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2"
  },
  "dsh": {
    "client": {
      "external": [
        "react",
        "react-dom",
        "react/jsx-runtime",
        "@deepseek-ai/cordis"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  }
}
