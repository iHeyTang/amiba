{
  "$schema": "../../packages/extension-api/src/manifest.schema.json",
  "id": "io.hermes.knowledge-base",
  "name": "Knowledge Base",
  "version": "0.1.0",
  "engines": { "hermes-x": "^0.1.0" },
  "entries": { "main": "dist/main.cjs" },
  "contributes": {
    "activityBar": [
      {
        "id": "knowledge",
        "icon": "book-open",
        "labels": { "en": "Knowledge Base", "zh-CN": "知识库" },
        "order": 200
      }
    ],
    "sidebarViews": [
      {
        "id": "knowledge",
        "anchor": "activityBar:knowledge",
        "view": "dist/ui/sidebar/index.html"
      }
    ],
    "settingsTabs": [
      {
        "id": "knowledge",
        "labels": { "en": "Knowledge Base", "zh-CN": "知识库" },
        "icon": "book-open",
        "view": "dist/ui/settings/index.html",
        "order": 100
      }
    ],
    "composerHints": [
      {
        "id": "brain-disconnected",
        "view": "dist/ui/hint/index.html"
      }
    ]
  },
  "hermesPlugins": [
    { "id": "gbrain", "version": "^0", "required": false }
  ],
  "permissions": ["ipc", "settings", "i18n", "lifecycle.boot"]
}
